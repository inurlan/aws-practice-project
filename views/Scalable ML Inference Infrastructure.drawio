        <mxCell id="-QjtrjUzRDEMRZ5MF8oH-47" value="Scalable ML Inference Infrastructure Architecture" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1" parent="1" vertex="1">
