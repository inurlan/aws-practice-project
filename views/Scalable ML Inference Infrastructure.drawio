        <mxCell id="MtDMNq1w1HRKt9dQc9m3-447" value="VPC" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=0;fontFamily=Helvetica;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="-2466" y="1270" width="1876" height="2740" as="geometry" />
        </mxCell>
        <mxCell id="MtDMNq1w1HRKt9dQc9m3-448" value="!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-385.5" y="2498" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="MtDMNq1w1HRKt9dQc9m3-449" value="To ensure internal network security VPC is applied. Moreover, external access priveledges are granulated with IAM service and all user data are encrypted using KMS service." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="-329" y="2498" width="449" height="79.5" as="geometry" />
        </mxCell>
        <mxCell id="MtDMNq1w1HRKt9dQc9m3-450" value="When users requests ML Inference of their data, user API enters via API Gatewat hitting first S3 bucket to store raw data. Once fresh data in the bucket EventBridge triggers data processing pipeline where data pases through Amazon SNS towards SQS. SNS is there for future scalability (e.g alternative processing pipeline wants to use this processing in future). SQS is queuing service to provide scalability and load balancing enabling AWS Lambda to function properly. Finally, processed and ready for ML inferencing data is stored in S3 bucket and sent to the inference endpoint." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="-329" y="2085.88" width="449" height="154.12" as="geometry" />
        </mxCell>
        <mxCell id="MtDMNq1w1HRKt9dQc9m3-452" value="R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-385.5" y="2583" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="MtDMNq1w1HRKt9dQc9m3-453" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;References&lt;/b&gt;&lt;/font&gt;:&lt;div&gt;&lt;br&gt;&lt;div&gt;1. Amazon SageMaker documentation&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;https://docs.aws.amazon.com/sagemaker/latest/dg/train-model.html&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. AWS Documentation&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;https://docs.aws.amazon.com/&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3. MLOps: The 4-pipeline Batch Architecture&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;by Mic, Principal ML Engineer @ ADP&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;https://medium.com/mlops-republic/mlops-the-4-pipeline-batch-architecture-fc9f6a415f5b&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;4. MLOps: Batch vs Online ML Systems&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;by Mic, Principal ML Engineer @ ADP&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;https://medium.com/mlops-republic/mlops-batch-vs-online-ml-system-cbacee834837&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;5.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Most Common Data Architecture Patterns For Data Engineers To Know In AWS&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;by Adriano Nicolucci, AWS Certified Specialist&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;https://aws.plainenglish.io/most-common-data-architecture-patterns-for-data-engineers-to-know-in-aws-72bc6ea81ed&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;6.&amp;nbsp;&lt;/span&gt;https://www.run.ai/guides/cloud-deep-learning/ai-inf erence&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;7.&amp;nbsp;https://www.oracle.com/artificial-intelligence/ai-inference/&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;8.&amp;nbsp;https://research.ibm.com/blog/AI-inference-explained&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;9.https://gcore.com/learning/what-is-ai-inference/&l